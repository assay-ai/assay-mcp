{
  "name": "@goassay-ai/sdk",
  "version": "0.1.0",
  "description": "Assay buyer SDK for Node. Calls Assay tools with an API key; payments are signed locally by the caller's own signer.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assay-ai/assay-mcp.git",
    "directory": "sdk/node"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/sdk/node/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/sdk/node/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "example": "node run-example.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "openai": "7.39.0",
    "typescript": "6.0.3",
    "viem": "2.57.3",
    "vitest": "5.0.3"
  }
}
